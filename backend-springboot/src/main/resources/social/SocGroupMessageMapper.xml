<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reader.social.mapper.SocGroupMessageMapper">

    <resultMap type="SocGroupMessage" id="SocGroupMessageResult">
        <result property="id"    column="id"    />
        <result property="groupId"    column="group_id"    />
        <result property="senderId"    column="sender_id"    />
        <result property="senderName"    column="sender_name"    />
        <result property="avatar"    column="avatar"    />
        <result property="sendTime"    column="send_time"    />
        <result property="content"    column="content"    />
        <result property="messageType"    column="message_type"    />
        <result property="isWithdrawn"    column="is_withdrawn"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="isDeleted"    column="is_deleted"    />
    </resultMap>

    <sql id="selectSocGroupMessageVo">
        select id, group_id, sender_id, sender_name, avatar, send_time, content, message_type, is_withdrawn, create_time, update_time, is_deleted from soc_group_message
    </sql>

    <select id="selectSocGroupMessageList" parameterType="SocGroupMessage" resultMap="SocGroupMessageResult">
        <include refid="selectSocGroupMessageVo"/>
        <where>
            <if test="groupId != null "> and group_id = #{groupId}</if>
            <if test="senderId != null "> and sender_id = #{senderId}</if>
            <if test="senderName != null  and senderName != ''"> and sender_name like concat('%', #{senderName}, '%')</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="sendTime != null  and sendTime != ''"> and send_time = #{sendTime}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="messageType != null  and messageType != ''"> and message_type = #{messageType}</if>
            <if test="isWithdrawn != null "> and is_withdrawn = #{isWithdrawn}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
        </where>
    </select>

    <select id="selectSocGroupMessageById" parameterType="Long" resultMap="SocGroupMessageResult">
        <include refid="selectSocGroupMessageVo"/>
        where id = #{id}
    </select>

    <insert id="insertSocGroupMessage" parameterType="SocGroupMessage">
        insert into soc_group_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="groupId != null">group_id,</if>
            <if test="senderId != null">sender_id,</if>
            <if test="senderName != null">sender_name,</if>
            <if test="avatar != null">avatar,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="content != null">content,</if>
            <if test="messageType != null">message_type,</if>
            <if test="isWithdrawn != null">is_withdrawn,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="groupId != null">#{groupId},</if>
            <if test="senderId != null">#{senderId},</if>
            <if test="senderName != null">#{senderName},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="content != null">#{content},</if>
            <if test="messageType != null">#{messageType},</if>
            <if test="isWithdrawn != null">#{isWithdrawn},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
        </trim>
    </insert>

    <update id="updateSocGroupMessage" parameterType="SocGroupMessage">
        update soc_group_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupId != null">group_id = #{groupId},</if>
            <if test="senderId != null">sender_id = #{senderId},</if>
            <if test="senderName != null">sender_name = #{senderName},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="sendTime != null">send_time = #{sendTime},</if>
            <if test="content != null">content = #{content},</if>
            <if test="messageType != null">message_type = #{messageType},</if>
            <if test="isWithdrawn != null">is_withdrawn = #{isWithdrawn},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSocGroupMessageById" parameterType="Long">
        delete from soc_group_message where id = #{id}
    </delete>

    <delete id="deleteSocGroupMessageByIds" parameterType="String">
        delete from soc_group_message where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>